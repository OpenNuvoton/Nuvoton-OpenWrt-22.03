if	TARGET_ma35h0
config MA35H0_SECURE_BOOT
	bool "MA35H0 Secure Boot"
	default n
	help
	  MA35H0 Secure Boot is a first level bootloader for the MA35H0
	  devices.

if	MA35H0_SECURE_BOOT

config MA35H0_AES_KEY
	string "AES Key"
	default "0A0BC81E5AFBF836C5E0CFBEA12C1E269A2EBC3B0B6EC39EEE1C7142F760EBC4"
	help
	  AES Key

config MA35H0_ECDSA_KEY
	string "ECDSA Key"
	default "8F1571E9975006A545DF854264F7B18934B5CB2EE619E66DBC0FBEA52C71C919"
	help
          ECDSA Key
endif

config TARGET_SDCARD_DATA_PARTSIZE
	int "SD card rootfs_data (overlay) partition size (in MiB)"
	default 100
	help
	  Size of the 4th SD-card partition ("rootfs_data") used as the
	  writable /overlay on top of a read-only squashfs root.

	  > 0 : build a read-only squashfs root plus this ext4 overlay, so
	        sysupgrade/OTA can preserve settings (mirrors squashfs+ubifs
	        NAND).
	  = 0 : build a single writable ext4 root and no overlay partition;
	        settings are preserved via the sysupgrade config backup.
endif
